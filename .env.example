# Set NODE_ENV=production in the hosting provider's environment settings.
NODE_ENV=development
# Most hosts assign PORT automatically. Keep this local value for development.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# In production, use the exact public web app origin (scheme + hostname, no path).
# Multiple allowed origins may be comma-separated.
CLIENT_ORIGIN=http://localhost:5173
# Generate a unique random secret of at least 32 characters for each deployment.
SESSION_TOKEN_SECRET=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
